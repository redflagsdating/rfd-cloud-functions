{
  "name": "rfd-cloud-functions",
  "private": true,
  "scripts": {
    "lint": "yarn workspaces run lint",
    "test": "yarn workspaces run test",
    "test:ci": "yarn workspaces run test:ci",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "functions"
    ],
    "nohoist": [
      "**/firebase-admin",
      "**/firebase-admin/**",
      "**/firebase-functions",
      "**/firebase-functions/**"
    ]
  },
  "engines": {
    "node": "18"
  },
  "lint-staged": {
    "functions/**/*.js|ts": "yarn lint"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "typescript": "^4.9.0"
  }
}
